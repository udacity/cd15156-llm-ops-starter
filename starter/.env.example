# === API Keys ===
OPENAI_API_KEY=sk-your-openai-api-key
# Leave OPENAI_BASE_URL blank for the stock OpenAI API. If your course
# workspace issues a Vocareum key (prefix `voc-`), set it to:
#   OPENAI_BASE_URL=https://openai.vocareum.com/v1
OPENAI_BASE_URL=

# === Chroma (Vector DB) ===
# Embedded persistent client — no Docker, no server. Override the path
# only if you want the on-disk store somewhere other than data/chroma.
# CHROMA_PATH=data/chroma

# === Tracing ===
# "phoenix" (default) launches an in-process Phoenix UI at
# http://localhost:6006 with traces persisted under data/phoenix/.
# "none" disables tracing (useful for tests/CI). Override the Phoenix
# host/port/working dir below if needed.
TRACING_BACKEND=phoenix
# PHOENIX_EMBEDDED=true
# PHOENIX_HOST=0.0.0.0
# PHOENIX_PORT=6006
# PHOENIX_WORKING_DIR=data/phoenix
# PHOENIX_PROJECT_NAME=llm-ops-capstone

# === Models ===
MODEL_COMPLEX=gpt-4o
MODEL_SIMPLE=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# === Application ===
CONFIDENCE_THRESHOLD=0.7
COST_LOG_PATH=data/cost_log.jsonl

# === Guardrails — output side ===
# Minimum entailment score the FactualConsistency NLI scanner requires
# of the answer vs. the retrieved context. Below this the answer is
# blocked as a hallucination. LLM Guard's upstream default is 0.75
# (strict single-claim verification); 0.3 fits descriptive RAG prose.
# Tune up to catch more potential hallucinations, down to let more
# answers through. See INSTRUCTIONS.md §6 Task 6 for tuning guidance.
# GUARDRAILS_FACTUALITY_MIN_SCORE=0.3
